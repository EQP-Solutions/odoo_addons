<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_eqp_backups">
            <field name="name">EQP Automatic Backups</field>
            <field name="sequence">200</field>
        </record>

        <record id="group_eqp_backups_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="eqp_backups.module_category_eqp_backups"/>
        </record>

        <record id="group_eqp_backups_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="eqp_backups.module_category_eqp_backups"/>
            <field name="implied_ids" eval="[(4, ref('eqp_backups.group_eqp_backups_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-company rules -->
        <record id="rule_backup_server_multi_company" model="ir.rule">
            <field name="name">Backup Server: multi-company</field>
            <field name="model_id" ref="model_backup_server"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_backup_record_multi_company" model="ir.rule">
            <field name="name">Backup Record: multi-company</field>
            <field name="model_id" ref="model_backup_record"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
